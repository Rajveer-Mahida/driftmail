{
  // Driftmail: one Worker serves the app, receives mail for EVERY domain you
  // add, and configures its own delivery. Add domains in the app (Domains page),
  // not by deploying more copies.
  //
  // Deploy:  pnpm install && pnpm run deploy   (or the Deploy to Cloudflare button)
  // Then open the Worker's URL — /setup does the rest, including the database.
  //
  // Nothing here is account-specific, on purpose:
  //   - No database_id. `wrangler deploy` finds the D1 database by name in your
  //     account and reuses it, or creates it if it doesn't exist yet. Same for
  //     the R2 bucket. So this file never needs editing and never leaks an id.
  //   - Fixed names. The Email Routing catch-all points at the Worker BY NAME,
  //     so the app assumes "driftmail". If you rename the Worker, set a
  //     WORKER_NAME var to match.
  //   - No migrations in the deploy command. The Worker applies them itself:
  //     automatically on an empty database, and from Settings → "Update
  //     database" when a new version brings more.
  //
  // `pnpm run deploy`, not `pnpm deploy` — the latter is pnpm's own built-in
  // command and shadows the script.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "driftmail",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // The SPA and the API are one Worker on one hostname. run_worker_first keeps
  // /api/* away from the static asset handler.
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "driftmail",
      // Kept for local development (`pnpm db:local`) and manual recovery with
      // `wrangler d1 migrations apply`. Production uses the in-app runner,
      // which writes the same d1_migrations ledger.
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "EMAIL_CACHE", "bucket_name": "driftmail-mail" }],

  // Outbound, when Cloudflare is chosen as the sending provider in the wizard.
  // Unrestricted, so the choice can change without a redeploy; the app enforces
  // its own from-address policy in apps/api/src/send.
  "send_email": [{ "name": "EMAIL" }],

  // Undo-send and scheduled send.
  "triggers": { "crons": ["* * * * *"] }

  // No "vars" block, deliberately: every var declared here becomes a field in
  // the deploy button's form, and all configuration lives in D1.
  //
  // Optional secrets/vars, added afterwards under Worker → Settings → Variables:
  //
  //   SETUP_TOKEN     accepted by /api/setup/claim instead of a Cloudflare API
  //                   token, for operators who would rather not give this app a
  //                   DNS-capable token.
  //   CONFIG_ENC_KEY  wraps stored credentials at rest. Worth setting only
  //                   because it lives OUTSIDE the database — see the trust
  //                   boundary note in apps/api/src/config/secrets.ts.
  //   WORKER_NAME     only if you deployed under a name other than "driftmail".
}
