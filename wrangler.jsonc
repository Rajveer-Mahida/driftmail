{
  // One-click "Deploy to Cloudflare" config.
  //
  // The deploy flow clones this repo, provisions the D1 database and R2 bucket
  // below under YOUR account (rewriting their names and ids), then runs the root
  // package.json `build` and `deploy` scripts.
  //
  // Deploying by hand? Use `pnpm run deploy` — plain `pnpm deploy` is pnpm's own
  // built-in command and shadows the script.
  //
  // Everything else is configured in the browser at /setup — there is nothing to
  // type into the deploy form, and no `wrangler secret put` to run afterwards.
  //
  // The resource names below are the generic defaults. A D1 database can never
  // be renamed once created, so if you're deploying from a clone, run
  // `pnpm provision <your-domain>` FIRST — it creates them named after your
  // domain and rewrites the names and ids here. Deploying from the button
  // instead? Rename them in the deploy form; you can't change them later.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rajveerz-qzz-io-driftmail",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // The SPA and the API are one Worker on one hostname. run_worker_first keeps
  // /api/* away from the static asset handler.
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rajveerz-qzz-io-driftmail",
      "database_id": "c38472e3-223a-484b-bf73-1899bbcdc054",
      "migrations_dir": "apps/api/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "EMAIL_CACHE", "bucket_name": "rajveerz-qzz-io-driftmail-mail" }],

  // Outbound, when Cloudflare is chosen as the sending provider in the wizard.
  // Unrestricted, so the choice can change without a redeploy; the app enforces
  // its own from-address policy in apps/api/src/send.
  "send_email": [{ "name": "EMAIL" }],

  // Undo-send and scheduled send.
  "triggers": { "crons": ["* * * * *"] }

  // No "vars" block, deliberately: every var declared here becomes a field in
  // the deploy button's form, and all configuration now lives in D1.
  //
  // No required secrets either. Two OPTIONAL ones can be added afterwards under
  // Worker → Settings → Variables and Secrets:
  //
  //   SETUP_TOKEN     accepted by /api/setup/claim instead of a Cloudflare API
  //                   token, for operators who would rather not give this app a
  //                   DNS-capable token.
  //   CONFIG_ENC_KEY  wraps stored credentials at rest. Worth setting only
  //                   because it lives OUTSIDE the database — see the trust
  //                   boundary note in apps/api/src/config/secrets.ts.
}
